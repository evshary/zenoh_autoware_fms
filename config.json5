{
  mode: "peer",
  transport: {
    link: {
      tx: {
        queue:{
          batching: {
            // Uncomment to disable batching if performance problems arise.
            // enabled: false,
          }
        }
      }
    }
  },
  listen: {
    endpoints: [
      'tcp/0.0.0.0:7887'
    ]
  },
  // The sim bridge plane: the camera and other <scope>/sensing keys live there.
  // Explicit connect so the link doesn't depend on discovery.
  connect: {
    endpoints: [
      'tcp/localhost:7447'
    ]
  },
}
